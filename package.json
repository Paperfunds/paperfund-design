{
  "name": "paperfund-designer-preview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite apps/web --config designer/vite.config.ts --host 127.0.0.1 --port 5230 --strictPort",
    "build": "vite build apps/web --config designer/vite.config.ts",
    "preview": "vite preview apps/web --config designer/vite.config.ts --host 127.0.0.1 --port 5230 --strictPort",
    "typecheck": "tsc -p designer/tsconfig.json --noEmit",
    "test": "vitest run --config designer/vite.config.ts --maxWorkers 2"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.2",
    "lightweight-charts": "5.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "vite": "7.3.6",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "@types/node": "22.20.4",
    "@playwright/test": "1.63.0"
  }
}